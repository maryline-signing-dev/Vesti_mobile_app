<?xml version="1.0" encoding="UTF-8" ?>
<!--
  WishlistDetailPage.xaml
  Conforme à la maquette "Wishlist : Détail".
  Deux états : lecture (IsNotEditing) et édition (IsEditing), sur la même page.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Wishlist.WishlistDetailPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,32" Spacing="16">

            <!-- En-tête -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                <Image Grid.Column="0"
                       Source="arrow_left_24dp.png"
                       WidthRequest="24" HeightRequest="24"
                       VerticalOptions="Center"
                       Margin="0,0,12,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Grid.Column="1"
                       Text="{Binding Item.Name}"
                       Style="{StaticResource TextH1}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </Grid>

            <Label IsVisible="{Binding HasError}"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource TextBody}"
                   TextColor="{StaticResource ColorError}" />

            <VerticalStackLayout Spacing="16" IsVisible="{Binding HasItem}">

                <!-- Photo -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="240">
                    <Grid>
                        <Image Source="{Binding Item.ImagePath,
                                   Converter={StaticResource RelativePathToFullConverter}}"
                               Aspect="AspectFill"
                               IsVisible="{Binding Item.ImagePath,
                                   Converter={StaticResource NotNullConverter}}" />
                        <Image Source="shirt_placeholder.png"
                               WidthRequest="72" HeightRequest="72"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding Item.ImagePath,
                                   Converter={StaticResource IsNullConverter}}" />
                    </Grid>
                </Border>

                <!-- ═══ MODE LECTURE ═══════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsNotEditing}">

                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource BrushBorder}" Padding="12,4">
                            <Label Text="{Binding Item.Category}" Style="{StaticResource TextCaption}" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource BrushBorder}" Padding="12,4">
                            <Label Text="{Binding Item.Color}" Style="{StaticResource TextCaption}" />
                        </Border>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Prix" Style="{StaticResource TextBody}" />
                        <Label Grid.Column="1" Text="{Binding Item.PriceLabel}"
                               Style="{StaticResource TextBody}"
                               TextColor="{StaticResource ColorTextSecondary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Lien" Style="{StaticResource TextBody}" />
                        <Label Grid.Column="1"
                               Text="{Binding Item.Link, TargetNullValue='Non renseigné'}"
                               Style="{StaticResource TextBody}"
                               TextColor="{StaticResource ColorTextSecondary}"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Référence" Style="{StaticResource TextBody}" />
                        <Label Grid.Column="1"
                               Text="{Binding Item.Reference, TargetNullValue='Non renseignée'}"
                               Style="{StaticResource TextBody}"
                               TextColor="{StaticResource ColorTextSecondary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                    <!-- Acquise : bouton masqué, statut affiché -->
                    <Button Text="Marquer comme acquise"
                            Style="{StaticResource BtnPrimary}"
                            Command="{Binding MarkAcquiredCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            IsVisible="{Binding IsAcquired,
                                Converter={StaticResource InvertBoolConverter}}"
                            Margin="0,8,0,0" />
                    <Label Text="Cette envie a déjà été acquise."
                           Style="{StaticResource TextCaption}"
                           TextColor="{StaticResource ColorSuccess}"
                           IsVisible="{Binding IsAcquired}" />

                    <Button Text="Modifier cette envie"
                            Style="{StaticResource BtnSecondary}"
                            Command="{Binding StartEditCommand}" />

                    <Button Text="Supprimer"
                            Style="{StaticResource BtnSecondary}"
                            TextColor="{StaticResource ColorError}"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding IsNotBusy}" />

                </VerticalStackLayout>

                <!-- ═══ MODE ÉDITION ════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditing}">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nom" Style="{StaticResource TextCaption}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrushBorder}"
                                BackgroundColor="{StaticResource ColorSurface}"
                                Padding="12,0" HeightRequest="48">
                            <Entry Text="{Binding Name}" Style="{StaticResource FieldBase}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Catégorie" Style="{StaticResource TextCaption}" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrushBorder}"
                                    BackgroundColor="{StaticResource ColorSurface}"
                                    Padding="12,0" HeightRequest="48">
                                <Picker ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding Category}"
                                        FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Couleur" Style="{StaticResource TextCaption}" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrushBorder}"
                                    BackgroundColor="{StaticResource ColorSurface}"
                                    Padding="12,0" HeightRequest="48">
                                <Picker ItemsSource="{Binding Colors}"
                                        SelectedItem="{Binding Color}"
                                        FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Prix (FCFA)" Style="{StaticResource TextCaption}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrushBorder}"
                                BackgroundColor="{StaticResource ColorSurface}"
                                Padding="12,0" HeightRequest="48">
                            <Entry Text="{Binding PriceText}" Keyboard="Numeric"
                                   Style="{StaticResource FieldBase}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Lien" Style="{StaticResource TextCaption}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrushBorder}"
                                BackgroundColor="{StaticResource ColorSurface}"
                                Padding="12,0" HeightRequest="48">
                            <Entry Text="{Binding Link}" Keyboard="Url"
                                   Style="{StaticResource FieldBase}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Référence" Style="{StaticResource TextCaption}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource BrushBorder}"
                                BackgroundColor="{StaticResource ColorSurface}"
                                Padding="12,0" HeightRequest="48">
                            <Entry Text="{Binding Reference}" Style="{StaticResource FieldBase}" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Enregistrer"
                            Style="{StaticResource BtnPrimary}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Annuler"
                            Style="{StaticResource BtnSecondary}"
                            Command="{Binding CancelEditCommand}" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
