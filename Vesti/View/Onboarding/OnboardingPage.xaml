<?xml version="1.0" encoding="UTF-8" ?>
<!--
  OnboardingPage.xaml
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Onboarding.OnboardingPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">

        <Grid Grid.Row="0">

            <!-- ── ÉTAPE 0 : Splash ──────────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding IsSplash}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="12"
                Padding="24,0">

                <Label Text="Vesti"
                       Style="{StaticResource TextLogo}"
                       HorizontalOptions="Center"
                       FontSize="48" />

                <BoxView WidthRequest="32" HeightRequest="2"
                         Color="{StaticResource ColorPrimary}"
                         HorizontalOptions="Center" />

                <Label Text="Votre style, en toute simplicité."
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="VOTRE DRESSING. VOTRE RYTHME."
                       Style="{StaticResource TextCaption}"
                       TextColor="{StaticResource ColorTextSecondary}"
                       HorizontalOptions="Center"
                       CharacterSpacing="2"
                       Margin="0,48,0,0" />

            </VerticalStackLayout>

            <!-- Overlay transparent sur le splash pour capter le tap -->
            <Grid IsVisible="{Binding IsSplash}"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextCommand}" />
                    <SwipeGestureRecognizer Direction="Up" Command="{Binding NextCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- ── ÉTAPE 1 : Organiser ───────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource EqualToOneConverter}}"
                Padding="24,48,24,0"
                Spacing="0">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Vesti" Style="{StaticResource TextLogo}" />
                    <Label Grid.Column="1" Text="Passer"
                           Style="{StaticResource TextCaption}"
                           TextColor="{StaticResource ColorTextSecondary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Image Lucide "shirt" -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="220"
                        Margin="0,24,0,28">
                    <Image Source="shirt_placeholder.png"
                           WidthRequest="80"
                           HeightRequest="80"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="01 / ORGANISER"
                       Style="{StaticResource TextCaption}"
                       TextColor="{StaticResource ColorPrimary}"
                       CharacterSpacing="1" />
                <Label Text="Tout votre dressing,&#x0a;au même endroit."
                       Style="{StaticResource TextH1}"
                       Margin="0,8,0,12" />
                <Label Text="Retrouvez vos vêtements en un regard. Ajoutez vos pièces et faites de la place à l'essentiel."
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}" />
            </VerticalStackLayout>

            <!-- ── ÉTAPE 2 : Composer ────────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding CurrentStep, Converter={StaticResource EqualToTwoConverter}}"
                Padding="24,48,24,0"
                Spacing="0">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Vesti" Style="{StaticResource TextLogo}" />
                    <Label Grid.Column="1" Text="Passer"
                           Style="{StaticResource TextCaption}"
                           TextColor="{StaticResource ColorTextSecondary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Trois icônes shirt alignées horizontalement — remplace 👔👖👟 -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="220"
                        Margin="0,24,0,28">
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Spacing="16">
                        <Image Source="shirt_placeholder.png"
                               WidthRequest="60" HeightRequest="60" />
                        <Image Source="shoes_placeholder.png"
                               WidthRequest="60" HeightRequest="60" />
                        <Image Source="shirt_placeholder.png"
                               WidthRequest="60" HeightRequest="60" />
                    </HorizontalStackLayout>
                </Border>

                <Label Text="02 / COMPOSER"
                       Style="{StaticResource TextCaption}"
                       TextColor="{StaticResource ColorPrimary}"
                       CharacterSpacing="1" />
                <Label Text="De belles tenues,&#x0a;avec vos pièces."
                       Style="{StaticResource TextH1}"
                       Margin="0,8,0,12" />
                <Label Text="Associez, remplacez, recommencez. Enregistrez les compositions qui vous ressemblent."
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}" />
            </VerticalStackLayout>

            <!-- ── ÉTAPE 3 : Planifier ───────────────────────────── -->
            <VerticalStackLayout
                IsVisible="{Binding IsLastStep}"
                Padding="24,48,24,0"
                Spacing="0">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Vesti" Style="{StaticResource TextLogo}" />
                    <Label Grid.Column="1" Text="Passer"
                           Style="{StaticResource TextCaption}"
                           TextColor="{StaticResource ColorTextSecondary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Mini-calendrier avec icône — remplace 🗓️👔👖👟 -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="220"
                        Margin="0,24,0,28">
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="16">
                        <!-- Mini-calendrier textuel -->
                        <Border BackgroundColor="{StaticResource ColorSurface}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                Padding="16,8"
                                HorizontalOptions="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image Grid.Column="0"
                                       Source="agenda_18dp.png"
                                       WidthRequest="18" HeightRequest="18"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Octobre"
                                       FontFamily="{StaticResource FontInter}"
                                       FontSize="{StaticResource TextSizeCaption}"
                                       TextColor="{StaticResource ColorTextPrimary}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <!-- Icônes de tenues -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                            <Image Source="shirt_placeholder.png"
                                   WidthRequest="48" HeightRequest="48" />
                            <Image Source="shirt_placeholder.png"
                                   WidthRequest="48" HeightRequest="48" />
                            <Image Source="shirt_placeholder.png"
                                   WidthRequest="48" HeightRequest="48" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="03 / PLANIFIER"
                       Style="{StaticResource TextCaption}"
                       TextColor="{StaticResource ColorPrimary}"
                       CharacterSpacing="1" />
                <Label Text="Votre style,&#x0a;à votre rythme."
                       Style="{StaticResource TextH1}"
                       Margin="0,8,0,12" />
                <Label Text="Préparez une tenue pour vos prochains rendez-vous. Ou gardez-la simplement pour plus tard."
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}" />
            </VerticalStackLayout>

        </Grid>

        <!-- ══ PIED DE PAGE ════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Padding="24,0,24,40"
              IsVisible="{Binding ShowFooter}">
            <VerticalStackLayout Spacing="20">

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <BoxView HeightRequest="4"
                             WidthRequest="{Binding ProgressWidth1}"
                             Color="{StaticResource ColorPrimary}"
                             CornerRadius="2" />
                    <BoxView HeightRequest="4"
                             WidthRequest="{Binding ProgressWidth2}"
                             Color="{StaticResource ColorBorder}"
                             CornerRadius="2" />
                    <BoxView HeightRequest="4"
                             WidthRequest="{Binding ProgressWidth3}"
                             Color="{StaticResource ColorBorder}"
                             CornerRadius="2" />
                </HorizontalStackLayout>

                <Button Text="Continuer"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding IsLastStep,
                            Converter={StaticResource InvertBoolConverter}}" />

                <Button Text="Commencer"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding StartCommand}"
                        IsVisible="{Binding IsLastStep}" />

            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
