<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Wardrobe.EditItemPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,32" Spacing="16">

            <!-- En-tête -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                <Label Grid.Column="0"
                       Text="←"
                       Style="{StaticResource TextH1}"
                       Padding="0,8,16,8"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1"
                       Text="Modifier la pièce"
                       Style="{StaticResource TextH1}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Zone photo (placeholder ; "Changer la photo" arrive en I3) -->
            <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    HeightRequest="200">
                <Label Text="👕"
                       FontSize="48"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Nom -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nom de la pièce" Style="{StaticResource TextCaption}" />
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BrushBorder}"
                        BackgroundColor="{StaticResource ColorSurface}"
                        Padding="12,0"
                        HeightRequest="48">
                    <Entry Text="{Binding Name}" Style="{StaticResource FieldBase}" />
                </Border>
            </VerticalStackLayout>

            <!-- Catégorie + Couleur -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Catégorie" Style="{StaticResource TextCaption}" />
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource BrushBorder}"
                            BackgroundColor="{StaticResource ColorSurface}"
                            Padding="12,0"
                            HeightRequest="48">
                        <Picker ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding Category}"
                                Title="Choisir"
                                TitleColor="{StaticResource ColorTextSecondary}"
                                TextColor="{StaticResource ColorTextPrimary}"
                                FontSize="14"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Couleur" Style="{StaticResource TextCaption}" />
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource BrushBorder}"
                            BackgroundColor="{StaticResource ColorSurface}"
                            Padding="12,0"
                            HeightRequest="48">
                        <Picker ItemsSource="{Binding Colors}"
                                SelectedItem="{Binding Color}"
                                Title="Choisir"
                                TitleColor="{StaticResource ColorTextSecondary}"
                                TextColor="{StaticResource ColorTextPrimary}"
                                FontSize="14"
                                VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Informations facultatives -->
            <Label Text="Informations facultatives"
                   Style="{StaticResource TextSectionTitle}"
                   Margin="0,8,0,0" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Saison" Style="{StaticResource TextCaption}" />
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BrushBorder}"
                        BackgroundColor="{StaticResource ColorSurface}"
                        Padding="12,0"
                        HeightRequest="48">
                    <Entry Text="{Binding Season}"
                           Placeholder="Toute l'année"
                           Style="{StaticResource FieldBase}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Style" Style="{StaticResource TextCaption}" />
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BrushBorder}"
                        BackgroundColor="{StaticResource ColorSurface}"
                        Padding="12,0"
                        HeightRequest="48">
                    <Entry Text="{Binding Style}"
                           Placeholder="Casual"
                           Style="{StaticResource FieldBase}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Marque" Style="{StaticResource TextCaption}" />
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource BrushBorder}"
                        BackgroundColor="{StaticResource ColorSurface}"
                        Padding="12,0"
                        HeightRequest="48">
                    <Entry Text="{Binding Brand}"
                           Placeholder="Non renseignée"
                           Style="{StaticResource FieldBase}" />
                </Border>
            </VerticalStackLayout>

            <!-- Message d'erreur de validation -->
            <Label IsVisible="{Binding HasError}"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource TextCaption}"
                   TextColor="{StaticResource ColorError}" />

            <Button Text="Enregistrer les modifications"
                    Style="{StaticResource BtnPrimary}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="0,8,0,0" />

            <Button Text="Annuler"
                    Style="{StaticResource BtnSecondary}"
                    Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
