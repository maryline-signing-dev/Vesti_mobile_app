<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Wardrobe.ItemDetailPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,32" Spacing="16">

            <!-- En-tête : flèche de retour + nom de la pièce -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                <Label Grid.Column="0"
                       Text="←"
                       Style="{StaticResource TextH1}"
                       Padding="0,8,16,8"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1"
                       Text="{Binding Item.Name}"
                       Style="{StaticResource TextH1}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </Grid>

            <!-- Pièce introuvable ou erreur de chargement -->
            <Label IsVisible="{Binding HasError}"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource TextBody}"
                   TextColor="{StaticResource ColorError}" />

            <!-- Contenu : visible uniquement quand la pièce est chargée -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding HasItem}">

                <!-- Zone photo (placeholder ; la vraie photo arrive en I3) -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="260">
                    <Label Text="👕"
                           FontSize="64"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Étiquettes catégorie et couleur -->
                <HorizontalStackLayout Spacing="8">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource BrushBorder}"
                            Padding="12,4">
                        <Label Text="{Binding Item.Category}"
                               Style="{StaticResource TextCaption}"
                               TextColor="{StaticResource ColorTextPrimary}" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource BrushBorder}"
                            Padding="12,4"
                            IsVisible="{Binding HasColor}">
                        <Label Text="{Binding Item.Color}"
                               Style="{StaticResource TextCaption}"
                               TextColor="{StaticResource ColorTextPrimary}" />
                    </Border>
                </HorizontalStackLayout>

                <Label Text="{Binding Item.Description}"
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}"
                       IsVisible="{Binding HasDescription}" />

                <!-- Lignes d'informations -->
                <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Saison" Style="{StaticResource TextBody}" />
                    <Label Grid.Column="1"
                           Text="{Binding SeasonText}"
                           Style="{StaticResource TextBody}"
                           TextColor="{StaticResource ColorTextSecondary}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Style" Style="{StaticResource TextBody}" />
                    <Label Grid.Column="1"
                           Text="{Binding StyleText}"
                           Style="{StaticResource TextBody}"
                           TextColor="{StaticResource ColorTextSecondary}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Marque" Style="{StaticResource TextBody}" />
                    <Label Grid.Column="1"
                           Text="{Binding BrandText}"
                           Style="{StaticResource TextBody}"
                           TextColor="{StaticResource ColorTextSecondary}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                <!-- Actions : "Composer avec cette pièce" arrive avec les tenues (I4) -->
                <Button Text="Modifier la pièce"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding EditCommand}"
                        Margin="0,8,0,0" />

                <Button Text="Supprimer la pièce"
                        Style="{StaticResource BtnSecondary}"
                        TextColor="{StaticResource ColorError}"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
