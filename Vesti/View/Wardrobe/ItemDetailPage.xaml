<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ItemDetailPage.xaml
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Wardrobe.ItemDetailPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,32" Spacing="16">

            <!-- En-tête -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                <Image Grid.Column="0"
                       Source="arrow_left_24dp.png"
                       WidthRequest="24" HeightRequest="24"
                       VerticalOptions="Center"
                       Margin="0,0,12,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Grid.Column="1"
                       Text="{Binding Item.Name}"
                       Style="{StaticResource TextH1}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </Grid>

            <Label IsVisible="{Binding HasError}"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource TextBody}"
                   TextColor="{StaticResource ColorError}" />

            <VerticalStackLayout Spacing="16" IsVisible="{Binding HasItem}">

                <!-- Zone photo : AspectFill remplit le conteneur sans déformer -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="260"
                        BackgroundColor="{StaticResource ColorPrimaryLight}">
                    <Grid>
                        <Image Source="{Binding FullImagePath}"
                               Aspect="AspectFill"
                               IsVisible="{Binding HasPhoto}" />
                        <Image Source="shirt_placeholder.png"
                               WidthRequest="80" HeightRequest="80"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasPhoto,
                                   Converter={StaticResource InvertBoolConverter}}" />
                        
                        <!-- favori — fond sombre semi-transparent → icône blanche -->
                        <Border BackgroundColor="#CC000000"
                                StrokeShape="RoundRectangle 100"
                                StrokeThickness="0"
                                WidthRequest="40" HeightRequest="40"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="12">
                            <Grid>
                                <!-- Non favori : cœur contour -->
                                <Image Source="heart_18dp_white.png"
                                       WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsFavorite,
                                           Converter={StaticResource InvertBoolConverter}}" />
                                <!-- Favori : cœur plein -->
                                <Image Source="heart_filled_18dp_white.png"
                                       WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsFavorite}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- Étiquettes catégorie + couleur -->
                <HorizontalStackLayout Spacing="8">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource BrushBorder}"
                            Padding="12,4">
                        <Label Text="{Binding Item.Category}"
                               Style="{StaticResource TextCaption}"
                               TextColor="{StaticResource ColorTextPrimary}" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource BrushBorder}"
                            Padding="12,4"
                            IsVisible="{Binding HasColor}">
                        <Label Text="{Binding Item.Color}"
                               Style="{StaticResource TextCaption}"
                               TextColor="{StaticResource ColorTextPrimary}" />
                    </Border>
                </HorizontalStackLayout>

                <Label Text="{Binding Item.Description}"
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}"
                       IsVisible="{Binding HasDescription}" />

                <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                <!-- Marque uniquement -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Marque" Style="{StaticResource TextBody}" />
                    <Label Grid.Column="1"
                           Text="{Binding BrandText}"
                           Style="{StaticResource TextBody}"
                           TextColor="{StaticResource ColorTextSecondary}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource ColorBorder}" />

                <!-- Bouton Modifier -->
                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource BrushBorder}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,14"
                        Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Grid.Column="0" Source="pencil_18dp.png"
                               WidthRequest="18" HeightRequest="18"
                               VerticalOptions="Center" Margin="0,0,10,0" />
                        <Label Grid.Column="1" Text="Modifier la pièce"
                               Style="{StaticResource TextBody}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Button Text="Composer avec cette pièce"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding EditCommand}"
                        Opacity="0.5"
                        IsEnabled="False" />

                <Button Text="Supprimer la pièce"
                        Style="{StaticResource BtnSecondary}"
                        TextColor="{StaticResource ColorError}"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
