<?xml version="1.0" encoding="UTF-8" ?>
<!--
  AddItemPage.xaml
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Wardrobe.AddItemPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid>

            <!-- ═══ FORMULAIRE ═══════════════════════════════════════ -->
            <VerticalStackLayout Padding="24,16,24,32"
                                 Spacing="16"
                                 IsVisible="{Binding IsNotSaved}">

                <!-- En-tête -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <Image Grid.Column="0"
                           Source="arrow_left_24dp.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center"
                           Margin="0,0,12,0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Grid.Column="1"
                           Text="Ajouter une pièce"
                           Style="{StaticResource TextH1}"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Zone photo — conforme maquette : Photo + Importer -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="200">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="16">

                        <!-- Placeholder icône shirt -->
                        <Image Source="shirt_placeholder.png"
                               WidthRequest="56"
                               HeightRequest="56"
                               HorizontalOptions="Center" />

                        <!-- Boutons Photo et Importer -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              Padding="16,0">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource ColorSurface}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Image Grid.Column="0"
                                           Source="camera_24dp.png"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Photo"
                                           Style="{StaticResource TextCaption}"
                                           TextColor="{StaticResource ColorTextPrimary}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource ColorSurface}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Image Grid.Column="0"
                                           Source="image_24dp.png"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Importer"
                                           Style="{StaticResource TextCaption}"
                                           TextColor="{StaticResource ColorTextPrimary}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Nom -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nom de la pièce" Style="{StaticResource TextCaption}" />
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource BrushBorder}"
                            BackgroundColor="{StaticResource ColorSurface}"
                            Padding="12,0"
                            HeightRequest="48">
                        <Entry Text="{Binding Name}"
                               Placeholder="Chemise blanche"
                               Style="{StaticResource FieldBase}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Catégorie + Couleur -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Catégorie" Style="{StaticResource TextCaption}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BrushBorder}"
                                BackgroundColor="{StaticResource ColorSurface}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding Category}"
                                    Title="Choisir"
                                    TitleColor="{StaticResource ColorTextSecondary}"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    FontSize="14"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Couleur" Style="{StaticResource TextCaption}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource BrushBorder}"
                                BackgroundColor="{StaticResource ColorSurface}"
                                Padding="12,0"
                                HeightRequest="48">
                            <Picker ItemsSource="{Binding Colors}"
                                    SelectedItem="{Binding Color}"
                                    Title="Choisir"
                                    TitleColor="{StaticResource ColorTextSecondary}"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    FontSize="14"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Erreur -->
                <Label IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}"
                       Style="{StaticResource TextCaption}"
                       TextColor="{StaticResource ColorError}" />

                <Button Text="Ajouter à mon dressing"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Label Text="Cette pièce sera possédée, pas ajoutée à la wishlist."
                       Style="{StaticResource TextCaption}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- ═══ CONFIRMATION ═════════════════════════════════════ -->
            <VerticalStackLayout Padding="24,48,24,32"
                                 Spacing="16"
                                 IsVisible="{Binding IsSaved}">

                <!-- Icône check Lucide -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 100"
                        StrokeThickness="0"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="Center">
                    <Image Source="check_24dp.png"
                           WidthRequest="28"
                           HeightRequest="28"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="Une pièce,&#x0a;plein de possibilités."
                       Style="{StaticResource TextH1}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- Photo de confirmation -->
                <Border BackgroundColor="{StaticResource ColorPrimaryLight}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        HeightRequest="160">
                    <Image Source="shirt_placeholder.png"
                           WidthRequest="64"
                           HeightRequest="64"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding SavedItem.Name}"
                       Style="{StaticResource TextSectionTitle}"
                       HorizontalOptions="Center" />

                <Label Text="{Binding SavedItem.Subtitle}"
                       Style="{StaticResource TextCaption}"
                       HorizontalOptions="Center" />

                <Label Text="{Binding ConfirmationText}"
                       Style="{StaticResource TextBody}"
                       TextColor="{StaticResource ColorTextSecondary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Button Text="Voir mon dressing"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding ViewWardrobeCommand}"
                        Margin="0,16,0,0" />

                <Button Text="Ajouter une autre pièce"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding AddAnotherCommand}" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
