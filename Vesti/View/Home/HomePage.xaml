<?xml version="1.0" encoding="UTF-8" ?>
<!--
  HomePage.xaml — Écran d'accueil (squelette I0)
  Sera remplacé par l'écran complet en I1.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Home.HomePage"
             BackgroundColor="{StaticResource ColorBackground}">

    <VerticalStackLayout Padding="{StaticResource PagePadding}"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <Label Text="Vesti"
               Style="{StaticResource TextLogo}"
               HorizontalOptions="Center" />

        <Label Text="Accueil — bientôt disponible"
               Style="{StaticResource TextCaption}"
               HorizontalOptions="Center"
               Margin="0,8,0,0" />

    </VerticalStackLayout>

</ContentPage>
