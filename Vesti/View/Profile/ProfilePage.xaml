<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ProfilePage.xaml 
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vesti.Views.Profile.ProfilePage"
             BackgroundColor="{StaticResource ColorBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,40" Spacing="0">

                <Label Text="Mon profil" Style="{StaticResource TextH1}" Margin="0,0,0,20" />

                <!-- Avatar + nom -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,0,28">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            StrokeShape="RoundRectangle 100"
                            StrokeThickness="0"
                            WidthRequest="52" HeightRequest="52">
                        <Label Text="{Binding InitialLetter}"
                               FontFamily="{StaticResource FontInter}"
                               FontSize="{StaticResource TextSizeH2}"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource TextSectionTitle}" />
                        <Label Text="Modifier mes informations"
                               Style="{StaticResource TextCaption}"
                               TextColor="{StaticResource ColorPrimary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToEditProfileCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <!-- Mon espace -->
                <Label Text="Mon espace" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,12" />

                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource BrushBorder}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Mes tenues" Style="{StaticResource TextBody}" />
                        <Label Grid.Column="1"
                               Text="{Binding OutfitCount, StringFormat='{0} tenues'}"
                               Style="{StaticResource TextCaption}"
                               TextColor="{StaticResource ColorTextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToOutfitsCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource BrushBorder}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,14" Margin="0,0,0,24">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Mes statistiques" Style="{StaticResource TextBody}" />
                        <Image Grid.Column="1" Source="chart_18dp.png"
                               WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToStatisticsCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Préférences & compte -->
                <Label Text="Préférences &amp; compte" Style="{StaticResource TextSectionTitle}" Margin="0,0,0,12" />

                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource BrushBorder}"
                        StrokeShape="RoundRectangle 12,12,0,0"
                        Padding="16,14" Margin="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Paramètres" Style="{StaticResource TextBody}" />
                        <Image Grid.Column="1" Source="settings_18dp.png"
                               WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource BrushBorder}"
                        StrokeShape="RoundRectangle 0,0,12,12"
                        Padding="16,14" Margin="0,0,0,28">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Aide &amp; contact" Style="{StaticResource TextBody}" />
                        <Image Grid.Column="1" Source="help_18dp.png"
                               WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHelpCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Effacer mes données (remplace "Se déconnecter") -->
                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource BrushBorder}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0" Source="trash_18dp.png"
                               WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Effacer mes données"
                               Style="{StaticResource TextBody}"
                               TextColor="{StaticResource ColorError}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowClearDataConfirmCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Label Text="Vesti" Style="{StaticResource TextLogo}" HorizontalOptions="Center" Margin="0,24,0,4" />
                <Label Text="Version 1.0 · Votre style, en toute simplicité."
                       Style="{StaticResource TextCaption}"
                       HorizontalOptions="Center" />

                <Label IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}"
                       Style="{StaticResource TextCaption}"
                       TextColor="{StaticResource ColorError}"
                       HorizontalOptions="Center"
                       Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ FEUILLE DE CONFIRMATION (superposée) ═══════════════════ -->
        <Grid IsVisible="{Binding IsClearDataConfirmVisible}"
              BackgroundColor="#80000000">
            <Border BackgroundColor="{StaticResource ColorSurface}"
                    StrokeShape="RoundRectangle 20,20,0,0"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    Padding="24,24,24,32">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Effacer mes données ?" Style="{StaticResource TextSectionTitle}" />
                    <Label Text="Votre dressing, vos tenues, votre agenda et votre wishlist seront définitivement supprimés de cet appareil. Cette action est irréversible."
                           Style="{StaticResource TextBody}"
                           TextColor="{StaticResource ColorTextSecondary}" />
                    <Button Text="Effacer définitivement"
                            Style="{StaticResource BtnPrimary}"
                            BackgroundColor="{StaticResource ColorError}"
                            Command="{Binding ConfirmClearDataCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="0,8,0,0" />
                    <Button Text="Annuler"
                            Style="{StaticResource BtnSecondary}"
                            Command="{Binding CancelClearDataCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
