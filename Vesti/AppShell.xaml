<?xml version="1.0" encoding="UTF-8" ?>
<!--
  AppShell.xaml — 4 onglets.
  Les ContentTemplate sont intentionnellement absents.
  Le contenu de chaque onglet est affecté dans AppShell.xaml.cs
  via le conteneur DI, ce qui garantit l'injection des ViewModels.
-->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="Vesti.AppShell"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="{StaticResource ColorSurface}"
       Shell.TabBarForegroundColor="{StaticResource ColorPrimary}"
       Shell.TabBarTitleColor="{StaticResource ColorPrimary}"
       Shell.TabBarUnselectedColor="{StaticResource ColorTextSecondary}">

    <TabBar>
        <ShellContent x:Name="HomeTab"
                      Title="Accueil"
                      Icon="home_18_dp.png"
                      Route="home" />

        <ShellContent x:Name="WardrobeTab"
                      Title="Dressing"
                      Icon="wardrobe_18dp.png"
                      Route="wardrobe" />

        <ShellContent x:Name="AgendaTab"
                      Title="Agenda"
                      Icon="agenda_18dp.png"
                      Route="agenda" />

        <ShellContent x:Name="ProfileTab"
                      Title="Profil"
                      Icon="profil_18dp.png"
                      Route="profile" />
    </TabBar>

</Shell>
