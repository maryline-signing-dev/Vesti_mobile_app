<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Vesti"
             x:Class="Vesti.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertBoolConverter             x:Key="InvertBoolConverter" />
            <conv:NotNullConverter                x:Key="NotNullConverter" />
            <conv:IsNullConverter                 x:Key="IsNullConverter" />
            <conv:EqualToZeroConverter            x:Key="EqualToZeroConverter" />
            <conv:EqualToOneConverter             x:Key="EqualToOneConverter" />
            <conv:EqualToTwoConverter             x:Key="EqualToTwoConverter" />
            <conv:GreaterThanZeroConverter        x:Key="GreaterThanZeroConverter" />
            <conv:FilterChipColorConverter        x:Key="FilterChipColorConverter" />
            <conv:FilterChipTextColorConverter    x:Key="FilterChipTextColorConverter" />
            <conv:SearchLabelConverter            x:Key="SearchLabelConverter" />
            <conv:RelativePathToFullConverter     x:Key="RelativePathToFullConverter" />
            <conv:SelectedDayColorConverter       x:Key="SelectedDayColorConverter" />
            <conv:SelectedDayTextColorConverter   x:Key="SelectedDayTextColorConverter" />
            <conv:CurrentMonthOpacityConverter    x:Key="CurrentMonthOpacityConverter" />
            <conv:StatsTitleConverter             x:Key="StatsTitleConverter" />
            <conv:RatioToWidthConverter           x:Key="RatioToWidthConverter" />
            <conv:IsEmptyOrNullConverter          x:Key="IsEmptyOrNullConverter" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
